{
  "name": "lpp-private-records",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir /tmp/lpp-worker-check",
    "cloud:login": "wrangler login",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
